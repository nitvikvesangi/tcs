# =============================================================================
# Quick Commerce Retail Intelligence Platform — Environment Variables
# Copy this file to `.env` and fill in real values for local development.
# =============================================================================

# --- General ---
APP_ENV=development
DEBUG=true

# --- Database ---
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/qcommerce_db

# --- Security ---
# Generate a strong random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Optional: Weather integration ---
# If left blank, the backend runs in "mock weather" mode using synthetic data.
WEATHER_API_KEY=
WEATHER_PROVIDER=mock

# --- Optional: LLM integration (AI chatbot) ---
# If left blank, the chatbot endpoint runs in a limited/mock mode with a
# clear message instead of failing the whole application.
LLM_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# --- Logging ---
LOG_LEVEL=INFO
